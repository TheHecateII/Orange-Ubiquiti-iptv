# TV Orange (VLAN 840) sur UniFi OS : interface iptv + proxy IGMP improxy.
# Basé sur jbbodart/orange-iptv (GPLv2).
[Unit]
Description=TV Orange (VLAN 840) via improxy
After=network.target
RequiresMountsFor=/data

[Service]
# Port WAN de la passerelle : parent de l'interface VLAN 832 (`ip -d link | grep -B2 'id 832'`)
Environment=WAN=eth6
ExecStartPre=-/sbin/ip link delete iptv
ExecStartPre=/sbin/ip link add link ${WAN} name iptv type vlan id 840 egress-qos-map 0:5 1:5 2:5 3:5 4:5 5:5 6:5 7:5
# IP factice : pas de DHCP sur le 840, mais improxy en veut une pour démarrer
ExecStartPre=/sbin/ip addr add 192.168.255.254/24 dev iptv
ExecStartPre=/sbin/ip link set iptv up
# Pidfile dédié pour ne pas écraser celui de l'improxy d'UniFi ; ajouter -d 5 pour le debug
ExecStart=/usr/sbin/improxy -c /data/orange-iptv/improxy.conf -p /run/improxy.orange-iptv.pid
ExecStopPost=-/sbin/ip link delete iptv
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
